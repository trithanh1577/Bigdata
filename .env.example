# Keep a real public project URL or replace it with your project's contact.
CRAWLER_USER_AGENT=GlobalCulinaryKnowledgeBase/1.0 (https://github.com/trithanh1577/Bigdata)
CRAWLER_TIMEOUT_SECONDS=25
CRAWLER_DELAY_SECONDS=1.5

# Optional Gemini model for bilingual answers, recipe translation, and web discovery.
# Store the real key only in the local .env file; never commit a secret key.
RECIPEHUB_LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RECIPEHUB_LLM_API_KEY=
RECIPEHUB_LLM_MODEL=gemini-3.8-flash
RECIPEHUB_LLM_TIMEOUT_SECONDS=45
