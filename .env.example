# Replace with a real project URL or contact email for source sites that require it.
CRAWLER_USER_AGENT=GlobalCulinaryKnowledgeBase/1.0 (https://github.com/trithanh1577/Bigdata)
CRAWLER_TIMEOUT_SECONDS=25
CRAWLER_DELAY_SECONDS=1.5

# Optional Gemini model for source-grounded answers, recipe translation, and web discovery.
# Gemini also enables web search for missing dishes; the crawler only saves pages with Recipe JSON-LD.
# Configure the key only in the server-side .env file. Never put it in frontend/config.js.
RECIPEHUB_LLM_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
RECIPEHUB_LLM_API_KEY=
RECIPEHUB_LLM_MODEL=gemini-3.8-flash
RECIPEHUB_LLM_TIMEOUT_SECONDS=45
